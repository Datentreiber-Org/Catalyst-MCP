# Copy this file to .env and choose exactly one provider block.
# To switch, comment out the active block and uncomment your chosen block.
# Replace placeholder keys only in .env.
# Load it with: uv run --locked --env-file .env catalyst-mcp --database data/catalyst.sqlite3 --live-analysis --live-ideation

# OpenAI
CATALYST_LLM_PROVIDER=openai
CATALYST_LLM_MODEL=gpt-6.1-sol
OPENAI_API_KEY=replace-with-your-openai-api-key

# Claude (Anthropic)
# CATALYST_LLM_PROVIDER=anthropic
# CATALYST_LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Ollama (local; no API key required)
# Start Ollama and install the selected model before calling either tool.
# CATALYST_LLM_PROVIDER=ollama
# CATALYST_LLM_MODEL=llama3.1:8b
# CATALYST_OLLAMA_HOST=http://localhost:11434

# Optional overrides; these are the current defaults.
# CATALYST_LLM_TIMEOUT_SECONDS=60
# CATALYST_LLM_MAX_OUTPUT_TOKENS=8192
